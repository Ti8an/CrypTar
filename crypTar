#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SRC_DIR="$SCRIPT_DIR/src"
VERSION="$(cat "$SCRIPT_DIR/VERSION")"

for f in "$SRC_DIR"/utils/*.sh; do
    [[ -e "$f" ]] && source "$f"
done
for f in "$SRC_DIR"/lib/*.sh; do
    [[ -e "$f" ]] && source "$f"
done

main() {
    case "${1:-}" in
        -s)        source "$SRC_DIR/commands/send.sh";            cmd_send "$@" ;;
        -d)        source "$SRC_DIR/commands/decrypt.sh";         cmd_decrypt "$@" ;;
        --server)  source "$SRC_DIR/commands/server/dispatch.sh"; srv_dispatch "$@" ;;
        --version) echo "CrypTar v$VERSION" ;;
        -h|--help) source "$SRC_DIR/commands/encrypt.sh";         cmd_help ;;
        *)         source "$SRC_DIR/commands/encrypt.sh";         cmd_encrypt "$@" ;;
    esac
}
main "$@"
